+// * SIMULATED BACKEND: when VITE_FAKE_API is set (e.g. http://localhost:3000) every request goes to that
+// * server as plain JSON instead of MTProto, and updates arrive over its /updates WebSocket
+const FAKE_API_URL: string = (import.meta as any).env?.VITE_FAKE_API || '';
+const FAKE_JSON = {
+  replacer(_key: string, value: any) {
+    if(value instanceof Uint8Array) return {__b64: bytesToB64(value)};
+    if(value instanceof ArrayBuffer) return {__b64: bytesToB64(new Uint8Array(value))};
+    if(typeof(value) === 'bigint') return value.toString();
+    return value;
+  },
+  reviver(_key: string, value: any) {
+    if(value && typeof(value) === 'object' && typeof(value.__b64) === 'string') return b64ToBytes(value.__b64);
+    return value;
+  }
+};
+function bytesToB64(bytes: Uint8Array) {
+  let s = '';
+  for(let i = 0; i < bytes.length; i += 0x8000) s += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000) as any);
+  return btoa(s);
+}
+function b64ToBytes(b64: string) {
+  const bin = atob(b64);
+  const out = new Uint8Array(bin.length);
+  for(let i = 0; i < bin.length; ++i) out[i] = bin.charCodeAt(i);
+  return out;
+}
